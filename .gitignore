# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.so

# ── Virtual environment ────────────────────────────────────────────────────────
venv/
.venv/
env/

# ── Training data (large; run build_dataset.py to recreate) ──────────────────
data/*.jsonl
data/*.bin
!data/.gitkeep

# ── Tokenizer binary (large; regenerate with utils/tokenizer.py) ─────────────
omega_tokenizer.json

# ── Model checkpoints & weights (large binary files) ──────────────────────────
checkpoints_aether2/**
!checkpoints_aether2/.gitkeep
checkpoints_omega/**
!checkpoints_omega/.gitkeep
*.safetensors
*.pt
*.pth

# ── Training logs ─────────────────────────────────────────────────────────────
*.log
logs/**
!logs/.gitkeep

# ── Claude Code session data ───────────────────────────────────────────────────
.claude/

# ── Triton / ROCm kernel cache ─────────────────────────────────────────────────
.triton/

# ── Misc ───────────────────────────────────────────────────────────────────────
.DS_Store
.env
